generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant: a sourcing channel / recruitment agency. All Candidate, JobOrder and
// Submission rows are scoped to exactly one tenant.
// ---------------------------------------------------------------------------
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates  Candidate[]
  jobOrders   JobOrder[]
  submissions Submission[]
  interviews  Interview[]
  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Auth. A User signs in with email + password and may belong to several
// tenants, with a role in each (Membership). The server decides which tenant a
// request may act on from these rows, never from a client-supplied header alone.
// ---------------------------------------------------------------------------
enum Role {
  ADMIN
  RECRUITER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Membership {
  userId   String @db.Uuid
  tenantId String @db.Uuid
  role     Role   @default(RECRUITER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  // The PK serves "tenants of this user"; this serves "members of this tenant".
  @@index([tenantId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// AuditLog: who did what, in which tenant. Written by middleware for every
// successful write request (and for logins), never edited.
// ---------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Skill: a single normalized skill name, shared across all tenants (skills
// like "React" or "SQL" aren't tenant-specific concepts). Candidate<->Skill
// and JobOrder<->Skill are both many-to-many via explicit join tables so the
// matching query is a plain join, not string parsing.
// ---------------------------------------------------------------------------
model Skill {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  candidateSkills CandidateSkill[]
  jobOrderSkills  JobOrderRequiredSkill[]

  @@map("skills")
}

// ---------------------------------------------------------------------------
// Candidate
// ---------------------------------------------------------------------------
model Candidate {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  fullName        String
  email           String?
  phone           String?
  location        String?
  experienceYears Decimal  @db.Decimal(4, 1)
  cvPath          String?
  cvOriginalName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skills      CandidateSkill[]
  submissions Submission[]

  // Email identifies a candidate within a tenant. Postgres treats NULLs as
  // distinct, so candidates without an email never collide. The app stores
  // emails lowercased (candidate.schema.ts) so this is effectively case-insensitive.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("candidates")
}

model CandidateSkill {
  candidateId String @db.Uuid
  skillId     String @db.Uuid

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
  // The [candidateId, skillId] PK only serves lookups starting with
  // candidateId. The matching query (jobOrder.repository.findMatchCounts)
  // joins on skillId, so it needs its own index to avoid a full scan of
  // this table on every match calculation.
  @@index([skillId])
  @@map("candidate_skills")
}

// ---------------------------------------------------------------------------
// JobOrder
// ---------------------------------------------------------------------------
model JobOrder {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  title           String
  clientName      String?
  location        String
  minExperience   Decimal        @db.Decimal(4, 1)
  numberOfOpenings Int
  status          JobOrderStatus @default(OPEN)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requiredSkills JobOrderRequiredSkill[]
  submissions Submission[]

  @@index([tenantId])
  @@map("job_orders")
}

enum JobOrderStatus {
  OPEN
  CLOSED
}

model JobOrderRequiredSkill {
  jobOrderId String @db.Uuid
  skillId    String @db.Uuid

  jobOrder JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobOrderId, skillId])
  @@index([skillId])
  @@map("job_order_required_skills")
}

// ---------------------------------------------------------------------------
// Submission: created when a recruiter shortlists a candidate against a job
// order. One candidate can only be shortlisted once per job order.
// ---------------------------------------------------------------------------
model Submission {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  candidateId String           @db.Uuid
  jobOrderId  String           @db.Uuid
  status      SubmissionStatus @default(SHORTLISTED)
  matchCount  Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOrder  JobOrder  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@unique([candidateId, jobOrderId])
  @@index([tenantId])
  // Job Order Details page (findByJobOrder) filters by jobOrderId directly;
  // the [candidateId, jobOrderId] unique index doesn't serve that lookup.
  @@index([jobOrderId])
  @@map("submissions")
}

enum SubmissionStatus {
  SHORTLISTED
  SUBMITTED_TO_CLIENT
  INTERVIEWING
  OFFERED
  REJECTED
  HIRED
}

// ---------------------------------------------------------------------------
// Interview: one round of interviewing against a Submission. Scheduling and
// status are tracked here; no calendar integration — scheduledAt is just a
// plain timestamp the recruiter enters.
// ---------------------------------------------------------------------------
model Interview {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  submissionId String          @db.Uuid
  round        Int
  scheduledAt  DateTime
  mode         InterviewMode
  status       InterviewStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([submissionId])
  @@map("interviews")
}

enum InterviewMode {
  PHONE
  VIDEO
  ONSITE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

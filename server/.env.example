DATABASE_URL="postgresql://talentfinder:talentfinder@localhost:55432/talentfinder?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Signs login tokens (JWT). REQUIRED: the server refuses to start without it.
# Must be random and at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# JWT_EXPIRES_IN="8h"

# Optional first-run bootstrap for hosts with no shell (e.g. Render free plan).
# If BOTH are set and the users table is empty, one admin is created with access
# to every existing tenant. It never runs again once any user exists.
# Otherwise create users with:  npm run create-user -- --help (see scripts/create-user.ts)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME="Administrator"

# Optional "Continue with Google". Off unless ALL THREE are set. Create an OAuth
# client (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_REDIRECT_URI as an authorized redirect URI. Invite-only: Google
# sign-in only works for an email that already has an account (npm run create-user).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Optional AI Feature (bonus, not required) — powers "Generate AI Insight" on
# the Job Order matching page. Leave AI_API_KEY unset to run without it; the
# endpoint returns a clear "not configured" message instead of failing.
# Works with any OpenAI-compatible chat completions endpoint. Defaults below
# target OpenAI directly (https://platform.openai.com/api-keys). Free-tier
# alternatives also work by changing base URL + model: Groq
# (https://api.groq.com/openai/v1), OpenRouter, or a local Ollama server
# (http://localhost:11434/v1).
AI_API_KEY=
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

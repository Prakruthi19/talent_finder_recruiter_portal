DATABASE_URL="postgresql://talentfinder:talentfinder@localhost:55432/talentfinder?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Optional AI Feature (bonus, not required) — powers "Generate AI Insight" on
# the Job Order matching page. Leave AI_API_KEY unset to run without it; the
# endpoint returns a clear "not configured" message instead of failing.
# Works with any OpenAI-compatible chat completions endpoint. Defaults below
# target OpenAI directly (https://platform.openai.com/api-keys). Free-tier
# alternatives also work by changing base URL + model: Groq
# (https://api.groq.com/openai/v1), OpenRouter, or a local Ollama server
# (http://localhost:11434/v1).
AI_API_KEY=
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
